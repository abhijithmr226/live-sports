# ==============================================================================
# CLOUDCAST SPORTS STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Never commit production credentials, secrets, or stream keys to git.
# Copy this file to .env and configure strong values.

# ----------------- SERVER & NETWORKING -----------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ----------------- SECURITY & ENCRYPTION -----------------
# 32-byte secret key (64 hexadecimal characters) used for AES-256-GCM encryption of stream keys.
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for user session tokens (min 32 characters)
JWT_SECRET=replace-with-a-very-secure-random-token-min32-characters-long

# ----------------- PERSISTENCE & DATABASE -----------------
# Local development default: SQLite (zero external installation required)
DATABASE_PATH=./cloudcast.db

# For production Docker / PostgreSQL deployments:
# DATABASE_URL=postgresql://cloudcast:secure_password@postgres:5432/cloudcast_db

# ----------------- QUEUE & DISTRIBUTED SCHEDULER -----------------
# Optional Redis connection for multi-worker distributed BullMQ queue:
# REDIS_URL=redis://redis:6379

# ----------------- STREAMING ENGINE (FFMPEG) -----------------
# Path to FFmpeg executable (default 'ffmpeg' assumes it is on system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Worker Node ID & Concurrency limits
WORKER_ID=worker-node-primary-01
MAX_CONCURRENT_JOBS=4
LOG_LEVEL=info

# ----------------- OPTIONAL SPORTS DATA PROVIDER -----------------
# SPORTS_DATA_API_KEY=
# SPORTS_DATA_PROVIDER=
